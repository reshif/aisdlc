{
  "name": "aisdlc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "node scripts/check-workspace-deps.mjs && npm run typecheck && npm run lint && npm run format:check && npm run test",
    "demo:ledger": "npm run build && node scripts/demo-ledger.mjs",
    "smoke:compose": "bash platform/compose/smoke.sh",
    "e2e:compose": "bash platform/compose/e2e.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
