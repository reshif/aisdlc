{
  "name": "aisdlc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ .",
    "format": "prettier --write --cache --cache-strategy content .",
    "format:check": "prettier --check --cache --cache-strategy content .",
    "test": "vitest run",
    "test:no-docker": "vitest run --project '!sandbox-driver' --project '!coding-runner'",
    "test:docker": "vitest run --project sandbox-driver --project coding-runner",
    "check": "node scripts/check.mjs",
    "check:changed": "node scripts/check.mjs --changed",
    "demo:ledger": "npm run build && node scripts/demo-ledger.mjs",
    "evidence:sec-ob-3": "SEC_OB_3_EVIDENCE_DIR=docs/evidence vitest run --project sandbox-driver sec-ob-3",
    "smoke:compose": "bash platform/compose/smoke.sh",
    "e2e:compose": "bash platform/compose/e2e.sh",
    "live:census": "bash platform/compose/live-census.sh",
    "lint:shell": "bash -n platform/compose/smoke.sh platform/compose/e2e.sh platform/compose/live-census.sh platform/compose/verify-ledger.sh && (command -v shellcheck >/dev/null && shellcheck -x platform/compose/*.sh platform/compose/init-secrets || echo shellcheck not installed: syntax checked only)"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
