{
  "name": "@aisdlc/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./files": {
      "types": "./src/prompt-files.ts",
      "default": "./src/prompt-files.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "gen": "vitest run -u test/lock.test.ts && vitest run -u test/generated.test.ts"
  },
  "dependencies": {
    "@aisdlc/contracts": "0.0.0",
    "@aisdlc/kernel": "0.0.0",
    "zod": "4.6.7"
  }
}
