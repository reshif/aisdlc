#!/usr/bin/env bash
# Generates everything the local-prod stack needs that must not be in git (see secrets/README.md):
#
#   secrets/tok-<caller>-<callee>    one service token per (caller, callee) pair, 48 hex characters
#   secrets/pg-superuser, pg-pass-*  Postgres passwords; db-url-*  the database URLs built from them
#   secrets/bff-oidc-client-secret   the bff's OIDC client secret (shared with the dev IdP)
#   secrets/anthropic-api-key        the model vendor key, mounted into the gateway ONLY. From $ANTHROPIC_API_KEY
#                                    when set; otherwise a placeholder (marked .anthropic-key-placeholder)
#                                    that no vendor accepts: the local routes use the fake provider anyway
#   secrets/github-app.pem           the GitHub App private key (a THROWAWAY key for the fake GitHub
#                                    until you replace it: see below); github-app.pub.pem its public half
#   .env                             non-secret settings compose interpolates (uid, App id, GitHub URLs)
#
# Every secret is a file, mode 0600, and each service mounts only the ones it needs. Existing files
# are kept: running this again is safe and changes nothing (--rotate regenerates tokens,
# passwords and the client secret; never the App key).
#
#   ./init-secrets                    fake GitHub settings in .env (the default: no credentials needed)
#   ./init-secrets --real-github      real App: put your key at secrets/github-app.pem first, and give
#                                     GITHUB_APP_ID and GITHUB_INSTALLATION_ID in the environment
#                                     (or edit .env afterwards)
#   ./init-secrets --fake-github      back to the fake settings
#   ./init-secrets --rotate           new tokens, passwords and client secret (down -v the stack first:
#                                     the database keeps the old passwords until db-init re-applies them)
set -euo pipefail
umask 077
cd "$(dirname "$0")"

mode=keep
rotate=0
for a in "$@"; do
  case "$a" in
    --real-github) mode=real ;;
    --fake-github) mode=fake ;;
    --rotate) rotate=1 ;;
    -h|--help) sed -n '2,28p' "$0"; exit 0 ;;
    *) echo "init-secrets: unknown argument $a" >&2; exit 2 ;;
  esac
done
command -v openssl >/dev/null || { echo "init-secrets: openssl is required" >&2; exit 1; }

mkdir -p secrets
chmod 700 secrets

# Containers run as a non-root user and read the secret files through a bind mount, so that user
# must own them. A normal user: your own uid (the files are already yours). root (CI, a sandbox):
# the image's user 10001.
if [ "$(id -u)" = 0 ]; then uid=10001; gid=10001; else uid="$(id -u)"; gid="$(id -g)"; fi

hex() { openssl rand -hex 24; }
# put NAME VALUE: create the secret unless it exists (or --rotate).
put() {
  if [ "$rotate" = 1 ] || [ ! -s "secrets/$1" ]; then printf '%s' "$2" >"secrets/$1"; fi
}

# Service tokens: caller-callee, so a leaked file names who it let in and where.
TOKENS="
notary-kms witness-kms killswitch-kms knowledge-kms bff-kms core-kms core-worker-kms identity-kms
core-notary core-worker-notary identity-notary
core-worker-witness
core-worker-killswitch operator-killswitch gateway-killswitch bff-killswitch
core-gateway core-worker-gateway operator-gateway operator-codehost
core-worker-identity codehost-identity knowledge-identity seed-identity
codehost-core identity-core operator-core bff-core
core-knowledge core-worker-knowledge
knowledge-codehost core-codehost core-worker-codehost
sandbox-controller-docker-coding smoke-docker-coding cvw-docker-cvw
core-worker-sandbox-controller operator-sandbox-controller bff-sandbox-controller sandbox-controller-core
core-worker-verify verify-codehost verify-sandbox-controller
gate-check-kms operator-gate-check bff-gate-check
gate-relay-kms operator-gate-relay
bff-notifier
audit-notary audit-kms audit-core bff-audit
"
for t in $TOKENS; do put "tok-$t" "$(hex)"; done

for r in aisdlc notary witness killswitch gateway sandbox-controller verify gate-check gate-relay notifier audit; do put "pg-pass-$r" "$(hex)"; done
put pg-superuser "$(hex)"
# URLs always follow the password files (they carry the password, so they are secrets too).
for r in aisdlc notary witness killswitch; do
  printf '%s://%s:%s@%s:5432/%s' postgres "$r" "$(cat "secrets/pg-pass-$r")" postgres "$r" >"secrets/db-url-$r"
done
# The gateway is not the owner of anything: its own login role in the record database (see db-init.sh).
printf '%s://%s:%s@%s:5432/%s' postgres gateway "$(cat secrets/pg-pass-gateway)" postgres aisdlc >secrets/db-url-gateway
# The sandbox-controller likewise (M14.2): its own login role, two relations readable (see db-init.sh).
printf '%s://%s:%s@%s:5432/%s' postgres sandbox_controller "$(cat secrets/pg-pass-sandbox-controller)" postgres aisdlc >secrets/db-url-sandbox-controller
# The verify service likewise (M14.3): its own login role, its own table and record streams (see db-init.sh).
printf '%s://%s:%s@%s:5432/%s' postgres verify "$(cat secrets/pg-pass-verify)" postgres aisdlc >secrets/db-url-verify
# gate-check likewise (M14.5): its own login role, read-only on what it checks (see db-init.sh and its migration).
printf '%s://%s:%s@%s:5432/%s' postgres gate_check "$(cat secrets/pg-pass-gate-check)" postgres aisdlc >secrets/db-url-gate-check
# gate-relay likewise (M15.3): its own login role, read-only on what it binds (see db-init.sh and its migration).
printf '%s://%s:%s@%s:5432/%s' postgres gate_relay "$(cat secrets/pg-pass-gate-relay)" postgres aisdlc >secrets/db-url-gate-relay
# The notifier likewise (M18): its own login role, its own tables and streams, read-only what it notifies about.
printf '%s://%s:%s@%s:5432/%s' postgres notifier "$(cat secrets/pg-pass-notifier)" postgres aisdlc >secrets/db-url-notifier
# The audit service likewise (M19): its own login role, its own streams and four entry types, read-only the record.
printf '%s://%s:%s@%s:5432/%s' postgres audit "$(cat secrets/pg-pass-audit)" postgres aisdlc >secrets/db-url-audit
put bff-oidc-client-secret "$(hex)"
# The object store's root credentials (MinIO): the store reads them as files; its callers (the S3 adapter) use
# the same two files through `file:` references. 24 hex characters each (MinIO wants 3 and 8 at least).
put object-store-access-key "$(hex)"
put object-store-secret-key "$(hex)"

# The model vendor key. Never overwritten by a placeholder; a real key replaces a placeholder (or, with
# --rotate, another key) when ANTHROPIC_API_KEY is set. The value never goes to .env or an argument list.
if [ -n "${ANTHROPIC_API_KEY:-}" ] && { [ ! -s secrets/anthropic-api-key ] || [ -e secrets/.anthropic-key-placeholder ] || [ "$rotate" = 1 ]; }; then
  printf '%s' "$ANTHROPIC_API_KEY" >secrets/anthropic-api-key
  rm -f secrets/.anthropic-key-placeholder
elif [ ! -s secrets/anthropic-api-key ]; then
  printf 'not-configured-%s' "$(hex)" >secrets/anthropic-api-key
  : >secrets/.anthropic-key-placeholder
fi

# The GitHub App key. Never overwritten. With none, a throwaway key (so the fake GitHub can verify
# the App JWTs the codehost signs); the marker records that it is not a real App's.
if [ "$mode" = real ]; then
  # Drop the throwaway key only if it is still the very key init-secrets made (its sha256 is in the
  # marker). A key copied over it is the user's real App key and is kept; an old empty marker cannot
  # tell, so refuse rather than delete a key that may be real.
  if [ -e secrets/.github-app-fake ]; then
    made="$(cat secrets/.github-app-fake)"
    have="$( [ -s secrets/github-app.pem ] && sha256sum secrets/github-app.pem | cut -d' ' -f1 || true)"
    if [ -n "$made" ] && [ "$have" = "$made" ]; then
      rm -f secrets/github-app.pem secrets/github-app.pub.pem secrets/.github-app-fake
    elif [ -n "$made" ] || [ -z "$have" ]; then
      rm -f secrets/.github-app-fake
    else
      echo "init-secrets: secrets/github-app.pem may be a throwaway key from a fake-GitHub run. If it is your real App key, delete secrets/.github-app-fake; if not, delete both. Then run this again." >&2
      exit 1
    fi
  fi
  if [ ! -s secrets/github-app.pem ]; then
    echo "init-secrets: put your GitHub App private key at $(pwd)/secrets/github-app.pem, then run this again" >&2
    exit 1
  fi
elif [ ! -s secrets/github-app.pem ]; then
  openssl genrsa -out secrets/github-app.pem 2048 2>/dev/null
  sha256sum secrets/github-app.pem | cut -d' ' -f1 >secrets/.github-app-fake
fi
openssl rsa -in secrets/github-app.pem -pubout -out secrets/github-app.pub.pem 2>/dev/null

# gate-check's OWN App key (M14.5): a different App from the codehost's, with `checks: write` only. Never
# overwritten. With none, a throwaway key the fake GitHub verifies; for the live run the user creates the App and
# puts its private key at secrets/gate-check-app.pem (the marker then goes away when it is replaced).
if [ ! -s secrets/gate-check-app.pem ]; then
  openssl genrsa -out secrets/gate-check-app.pem 2048 2>/dev/null
  : >secrets/.gate-check-app-fake
fi
openssl rsa -in secrets/gate-check-app.pem -pubout -out secrets/gate-check-app.pub.pem 2>/dev/null

# gate-relay's OWN App key (M15.3): a third App, with `deployments: write` only. Never overwritten. With none, a
# throwaway key the fake GitHub verifies; for the live run the user creates the App and puts its private key at
# secrets/gate-relay-app.pem.
if [ ! -s secrets/gate-relay-app.pem ]; then
  openssl genrsa -out secrets/gate-relay-app.pem 2048 2>/dev/null
  : >secrets/.gate-relay-app-fake
fi
openssl rsa -in secrets/gate-relay-app.pem -pubout -out secrets/gate-relay-app.pub.pem 2>/dev/null

# The issue twin's tracker App key (M16, DEC-20(a)): a fourth App, with `issues: write` and metadata read only. Never
# overwritten. With none, a throwaway key the fake GitHub verifies; for the live run the user creates the App and puts
# its private key at secrets/tracker-app.pem.
if [ ! -s secrets/tracker-app.pem ]; then
  openssl genrsa -out secrets/tracker-app.pem 2048 2>/dev/null
  : >secrets/.tracker-app-fake
fi
openssl rsa -in secrets/tracker-app.pem -pubout -out secrets/tracker-app.pub.pem 2>/dev/null

# .env: written when absent, or when a mode was asked for.
write_env() {
  {
    echo "# Written by ./init-secrets. Nothing secret here: ids, URLs and the uid the containers run as."
    echo "AISDLC_UID=$uid"
    echo "AISDLC_GID=$gid"
    if [ "$1" = fake ]; then
      echo "# Fake GitHub (compose profile fake-github): the codehost talks to it on its own loopback."
      echo "GITHUB_APP_ID=123456"
      echo "GITHUB_INSTALLATION_ID=1"
      echo "CODEHOST_GITHUB_API_URL=http://127.0.0.1:8353"
      echo "CODEHOST_GIT_URL=http://127.0.0.1:8354"
      echo "# gate-check's own App on the fake GitHub (M14.5): its own id and installation, reached on gatecheck-github."
      echo "GATE_CHECK_APP_ID=654321"
      echo "GATE_CHECK_INSTALLATION_ID=2"
      echo "GATE_CHECK_GITHUB_API_URL=http://codehost:8355"
      echo "# gate-relay's own App on the fake GitHub (M15.3): its own id and installation, reached on gaterelay-github."
      echo "GATE_RELAY_APP_ID=765432"
      echo "GATE_RELAY_INSTALLATION_ID=3"
      echo "GATE_RELAY_GITHUB_API_URL=http://codehost:8356"
      echo "# the issue twin's tracker App on the fake GitHub (M16): its own id and installation; the codehost holds it."
      echo "TRACKER_APP_ID=876543"
      echo "TRACKER_INSTALLATION_ID=4"
      echo "TRACKER_LOGIN=aisdlc-tracker[bot]"
      echo "TRACKER_GITHUB_API_URL=http://127.0.0.1:8353"
    else
      echo "# Real GitHub: leave the two URLs empty (the codehost defaults to api.github.com and github.com)."
      echo "GITHUB_APP_ID=${GITHUB_APP_ID:-REPLACE_ME}"
      echo "GITHUB_INSTALLATION_ID=${GITHUB_INSTALLATION_ID:-REPLACE_ME}"
      echo "CODEHOST_GITHUB_API_URL="
      echo "CODEHOST_GIT_URL="
      echo "# gate-check's own App (checks: write), created by the user for the live run; its key at secrets/gate-check-app.pem."
      echo "GATE_CHECK_APP_ID=${GATE_CHECK_APP_ID:-REPLACE_ME}"
      echo "GATE_CHECK_INSTALLATION_ID=${GATE_CHECK_INSTALLATION_ID:-REPLACE_ME}"
      echo "GATE_CHECK_GITHUB_API_URL="
      echo "# gate-relay's own App (deployments: write), created by the user for the live run; its key at secrets/gate-relay-app.pem."
      echo "GATE_RELAY_APP_ID=${GATE_RELAY_APP_ID:-REPLACE_ME}"
      echo "GATE_RELAY_INSTALLATION_ID=${GATE_RELAY_INSTALLATION_ID:-REPLACE_ME}"
      echo "GATE_RELAY_GITHUB_API_URL="
      echo "# the issue twin's tracker App (issues: write), created by the user for the live run; its key at secrets/tracker-app.pem"
      echo "# (the codehost holds it). Leave TRACKER_APP_ID and TRACKER_LOGIN empty until it exists: the issue_twin loop does not run."
      echo "TRACKER_APP_ID=${TRACKER_APP_ID:-}"
      echo "TRACKER_INSTALLATION_ID=${TRACKER_INSTALLATION_ID:-4}"
      echo "TRACKER_LOGIN=${TRACKER_LOGIN:-}"
      echo "TRACKER_GITHUB_API_URL="
    fi
  } >.env
}
if [ "$mode" != keep ]; then write_env "$mode"; elif [ ! -e .env ]; then write_env fake; else
  # Keep the file; refresh only the uid it names (the owner of the secrets may have changed).
  sed -i.bak -e "s/^AISDLC_UID=.*/AISDLC_UID=$uid/" -e "s/^AISDLC_GID=.*/AISDLC_GID=$gid/" .env && rm -f .env.bak
fi

# Ownership and mode, every time (a key you copied in arrives with whatever mode you had).
find secrets -maxdepth 1 -type f ! -name README.md -exec chmod 600 {} +
chmod 600 .env
if [ "$(id -u)" = 0 ]; then
  find secrets -maxdepth 1 -type f ! -name README.md -exec chown "$uid:$gid" {} +
  chown "$uid:$gid" secrets .env
fi
if [ -e secrets/.github-app-fake ]; then github=fake; else github=real; fi
if [ -e secrets/.anthropic-key-placeholder ]; then anthropic=placeholder; else anthropic=set; fi
echo "init-secrets: $(find secrets -maxdepth 1 -type f ! -name README.md ! -name '.*' | wc -l) secret files in $(pwd)/secrets (owner uid $uid, mode 0600), GitHub App key: $github, Anthropic key: $anthropic"
