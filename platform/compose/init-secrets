#!/usr/bin/env bash
# Generates everything the local-prod stack needs that must not be in git (see secrets/README.md):
#
#   secrets/tok-<caller>-<callee>    one service token per (caller, callee) pair, 48 hex characters
#   secrets/pg-superuser, pg-pass-*  Postgres passwords; db-url-*  the database URLs built from them
#   secrets/bff-oidc-client-secret   the bff's OIDC client secret (shared with the dev IdP)
#   secrets/github-app.pem           the GitHub App private key (a THROWAWAY key for the fake GitHub
#                                    until you replace it: see below); github-app.pub.pem its public half
#   .env                             non-secret settings compose interpolates (uid, App id, GitHub URLs)
#
# Every secret is a file, mode 0600, and each service mounts only the ones it needs. Existing files
# are kept: running this again is safe and changes nothing (--rotate regenerates tokens,
# passwords and the client secret; never the App key).
#
#   ./init-secrets                    fake GitHub settings in .env (the default: no credentials needed)
#   ./init-secrets --real-github      real App: put your key at secrets/github-app.pem first, and give
#                                     GITHUB_APP_ID and GITHUB_INSTALLATION_ID in the environment
#                                     (or edit .env afterwards)
#   ./init-secrets --fake-github      back to the fake settings
#   ./init-secrets --rotate           new tokens, passwords and client secret (down -v the stack first:
#                                     the database keeps the old passwords until db-init re-applies them)
set -euo pipefail
umask 077
cd "$(dirname "$0")"

mode=keep
rotate=0
for a in "$@"; do
  case "$a" in
    --real-github) mode=real ;;
    --fake-github) mode=fake ;;
    --rotate) rotate=1 ;;
    -h|--help) sed -n '2,24p' "$0"; exit 0 ;;
    *) echo "init-secrets: unknown argument $a" >&2; exit 2 ;;
  esac
done
command -v openssl >/dev/null || { echo "init-secrets: openssl is required" >&2; exit 1; }

mkdir -p secrets
chmod 700 secrets

# Containers run as a non-root user and read the secret files through a bind mount, so that user
# must own them. A normal user: your own uid (the files are already yours). root (CI, a sandbox):
# the image's user 10001.
if [ "$(id -u)" = 0 ]; then uid=10001; gid=10001; else uid="$(id -u)"; gid="$(id -g)"; fi

hex() { openssl rand -hex 24; }
# put NAME VALUE: create the secret unless it exists (or --rotate).
put() {
  if [ "$rotate" = 1 ] || [ ! -s "secrets/$1" ]; then printf '%s' "$2" >"secrets/$1"; fi
}

# Service tokens: caller-callee, so a leaked file names who it let in and where.
TOKENS="
notary-kms witness-kms knowledge-kms bff-kms core-kms core-worker-kms identity-kms
core-notary core-worker-notary identity-notary
core-worker-witness
core-worker-identity codehost-identity knowledge-identity seed-identity
codehost-core identity-core operator-core
core-knowledge core-worker-knowledge
knowledge-codehost core-codehost core-worker-codehost
"
for t in $TOKENS; do put "tok-$t" "$(hex)"; done

for r in aisdlc notary witness; do put "pg-pass-$r" "$(hex)"; done
put pg-superuser "$(hex)"
# URLs always follow the password files (they carry the password, so they are secrets too).
for r in aisdlc notary witness; do
  printf '%s://%s:%s@%s:5432/%s' postgres "$r" "$(cat "secrets/pg-pass-$r")" postgres "$r" >"secrets/db-url-$r"
done
put bff-oidc-client-secret "$(hex)"

# The GitHub App key. Never overwritten. With none, a throwaway key (so the fake GitHub can verify
# the App JWTs the codehost signs); the marker records that it is not a real App's.
if [ "$mode" = real ]; then
  if [ -e secrets/.github-app-fake ]; then
    rm -f secrets/github-app.pem secrets/github-app.pub.pem secrets/.github-app-fake
  fi
  if [ ! -s secrets/github-app.pem ]; then
    echo "init-secrets: put your GitHub App private key at $(pwd)/secrets/github-app.pem, then run this again" >&2
    exit 1
  fi
elif [ ! -s secrets/github-app.pem ]; then
  openssl genrsa -out secrets/github-app.pem 2048 2>/dev/null
  : >secrets/.github-app-fake
fi
openssl rsa -in secrets/github-app.pem -pubout -out secrets/github-app.pub.pem 2>/dev/null

# .env: written when absent, or when a mode was asked for.
write_env() {
  {
    echo "# Written by ./init-secrets. Nothing secret here: ids, URLs and the uid the containers run as."
    echo "AISDLC_UID=$uid"
    echo "AISDLC_GID=$gid"
    if [ "$1" = fake ]; then
      echo "# Fake GitHub (compose profile fake-github): the codehost talks to it on its own loopback."
      echo "GITHUB_APP_ID=123456"
      echo "GITHUB_INSTALLATION_ID=1"
      echo "CODEHOST_GITHUB_API_URL=http://127.0.0.1:8353"
      echo "CODEHOST_GIT_URL=http://127.0.0.1:8354"
    else
      echo "# Real GitHub: leave the two URLs empty (the codehost defaults to api.github.com and github.com)."
      echo "GITHUB_APP_ID=${GITHUB_APP_ID:-REPLACE_ME}"
      echo "GITHUB_INSTALLATION_ID=${GITHUB_INSTALLATION_ID:-REPLACE_ME}"
      echo "CODEHOST_GITHUB_API_URL="
      echo "CODEHOST_GIT_URL="
    fi
  } >.env
}
if [ "$mode" != keep ]; then write_env "$mode"; elif [ ! -e .env ]; then write_env fake; else
  # Keep the file; refresh only the uid it names (the owner of the secrets may have changed).
  sed -i.bak -e "s/^AISDLC_UID=.*/AISDLC_UID=$uid/" -e "s/^AISDLC_GID=.*/AISDLC_GID=$gid/" .env && rm -f .env.bak
fi

# Ownership and mode, every time (a key you copied in arrives with whatever mode you had).
find secrets -maxdepth 1 -type f ! -name README.md -exec chmod 600 {} +
chmod 600 .env
if [ "$(id -u)" = 0 ]; then
  find secrets -maxdepth 1 -type f ! -name README.md -exec chown "$uid:$gid" {} +
  chown "$uid:$gid" secrets .env
fi
if [ -e secrets/.github-app-fake ]; then github=fake; else github=real; fi
echo "init-secrets: $(find secrets -maxdepth 1 -type f ! -name README.md ! -name '.*' | wc -l) secret files in $(pwd)/secrets (owner uid $uid, mode 0600), GitHub App key: $github"
