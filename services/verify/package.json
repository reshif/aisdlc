{
  "name": "@aisdlc/verify-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "build": "node ../../scripts/bundle.mjs main && node ../../scripts/copy-prompts.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "@aisdlc/agents": "0.0.0",
    "@aisdlc/build": "0.0.0",
    "@aisdlc/contracts": "0.0.0",
    "@aisdlc/db": "0.0.0",
    "@aisdlc/kernel": "0.0.0",
    "@aisdlc/ports": "0.0.0",
    "@aisdlc/record": "0.0.0",
    "@aisdlc/service-kit": "0.0.0",
    "@aisdlc/verify": "0.0.0",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aisdlc/secrets-rules": "0.0.0"
  }
}
